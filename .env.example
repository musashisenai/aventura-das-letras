# Copie este arquivo para .env no computador do professor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
PORT=3000

# MySQL local (instalado no computador que executa o servidor)
LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=coloque_a_senha_do_mysql
LOCAL_MYSQL_DATABASE=aventura_das_letras

# Pasta persistente da escola. Exemplo: o disco D: não é restaurado ao reiniciar.
LOCAL_DATA_DIR=D:/AventuraDasLetras/dados
# Opcional: destino do backup manual. Por padrão, usa a Área de Trabalho.
# BACKUP_DIR=D:/AventuraDasLetras/backups

# Nunca publique o arquivo .env nem compartilhe a service_role key com os alunos.
