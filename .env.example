# MySQL connection string. Use the same database from every device/server.
# Example: mysql://USER:PASSWORD@HOST:3306/aventura_das_letras
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/aventura_das_letras

# DATABASE_URL is also accepted as an alias for compatibility.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/aventura_das_letras

PORT=4173

# Required only for the existing /manus-storage proxy.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Do not commit your real .env file.

