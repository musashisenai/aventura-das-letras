# Supabase project URL: Project Settings > Data API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Server-only secret: Project Settings > API > service_role key
# Never expose this key in client code or commit the real .env file.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

PORT=4173

# Required only for the existing /manus-storage proxy.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
